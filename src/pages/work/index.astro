---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const events = (await getCollection('eventsEn')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang={lang} path="/work" title={`${t('work.heading')} — ${t('site.title')}`}>
  <section class="wrap work-page">
    <header class="work-page__header fade-in">
      <p class="eyebrow">{t('work.heading')}</p>
      <h1>{t('work.heading')}</h1>
      <p class="work-page__intro">{t('work.intro')}</p>
    </header>

    <div class="work-page__grid">
      {
        events.map((event) => (
          <EventCard
            lang={lang}
            slug={event.id}
            title={event.data.title}
            location={event.data.location}
            date={event.data.date}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .work-page {
    padding-block: 8.5rem 5rem;
  }

  .work-page__header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: 0.4rem;
  }

  .work-page__intro {
    margin-top: 1rem;
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .work-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 720px) {
    .work-page__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
