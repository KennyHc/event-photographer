---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { useTranslations } from '../../i18n/ui';
import { href } from '../../lib/paths';
import { getCover, getEventImages, getShowcase } from '../../lib/images';

export async function getStaticPaths() {
  const events = await getCollection('eventsEn');
  return events.map((event) => ({ params: { slug: event.id }, props: { event, events } }));
}

const { event, events } = Astro.props as Awaited<
  ReturnType<typeof getStaticPaths>
>[number]['props'];

const lang = 'en' as const;
const t = useTranslations(lang);
const { Content } = await render(event);

const sorted = events.slice().sort((a, b) => a.data.order - b.data.order);
const idx = sorted.findIndex((e) => e.id === event.id);
const prevEvent = sorted[(idx - 1 + sorted.length) % sorted.length];
const nextEvent = sorted[(idx + 1) % sorted.length];

const images = getEventImages(event.id);
const cover = getCover(images);
const showcase = getShowcase(images);
---

<BaseLayout
  lang={lang}
  path={`/work/${event.id}`}
  title={`${event.data.title} | ${t('site.title')}`}
  description={event.data.summary}
  ogImage={cover.file}
>
  <article class="story">
    <div class="story__cover">
      <Image
        src={cover.file}
        alt={event.data.title}
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        loading="eager"
        format="webp"
        class="story__cover-img"
        transition:name={`cover-${event.id}`}
      />
    </div>

    <header class="wrap story__header fade-in">
      <p class="eyebrow">{event.data.location} · {event.data.date}</p>
      <h1 class="story__title">{event.data.title}</h1>
    </header>

    <div class="wrap story__body fade-in">
      <Content />
    </div>

    <div class="wrap story__gallery">
      <p class="eyebrow fade-in">{t('event.gallery')}</p>
      <Gallery images={showcase} altPrefix={`${event.data.title}, ${t('event.galleryAlt')}`} />
    </div>

    {
      event.data.testimonial && (
        <div class="wrap story__testimonial fade-in">
          <p class="eyebrow">{t('event.testimonial')}</p>
          <blockquote>
            <p>&ldquo;{event.data.testimonial.quote}&rdquo;</p>
            <cite>{event.data.testimonial.author}</cite>
          </blockquote>
        </div>
      )
    }

    <nav class="wrap story__nav" aria-label="Story navigation">
      <a href={href(`/work/${prevEvent.id}`, lang)} class="story__nav-link">
        <span class="eyebrow">{t('event.prev')}</span>
        <span>{prevEvent.data.title}</span>
      </a>
      <a href={href('/work', lang)} class="story__nav-back">{t('event.back')}</a>
      <a href={href(`/work/${nextEvent.id}`, lang)} class="story__nav-link story__nav-link--next">
        <span class="eyebrow">{t('event.next')}</span>
        <span>{nextEvent.data.title}</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .story__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 82vh;
    overflow: hidden;
  }

  .story__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story__header {
    padding-block: 2.5rem 1rem;
  }

  .story__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 0.4rem;
    max-width: 24ch;
  }

  .story__body {
    max-width: 68ch;
    padding-block: 1rem 3.5rem;
    font-size: 1.08rem;
  }

  .story__body :global(p) {
    margin-bottom: 1.3em;
    color: var(--color-text);
  }

  .story__gallery {
    padding-block: 1rem 4rem;
  }

  .story__testimonial {
    padding-block: 1rem 4rem;
    max-width: 56ch;
  }

  .story__testimonial blockquote {
    margin: 0.75rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    font-style: italic;
  }

  .story__testimonial cite {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .story__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 2.5rem 4rem;
    border-top: 1px solid var(--color-border);
  }

  .story__nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .story__nav-link--next {
    text-align: right;
    align-items: flex-end;
  }

  .story__nav-back {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 719px) {
    .story__cover {
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 640px) {
    .story__nav {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 1.25rem;
    }
    .story__nav-link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
