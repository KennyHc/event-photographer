---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import ServicesStrip from '../../components/ServicesStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import { useTranslations } from '../../i18n/ui';
import { getCover, getEventImages } from '../../lib/images';

const lang = 'es' as const;
const t = useTranslations(lang);

const events = (await getCollection('eventsEs')).sort((a, b) => a.data.order - b.data.order);
const heroCover = getCover(getEventImages('wedding-bali'));
---

<BaseLayout
  lang={lang}
  path="/"
  title={t('site.title')}
  description={t('site.description')}
  ogImage={heroCover.file}
  transparentHeader
>
  <section class="hero">
    <Image
      src={heroCover.file}
      alt="Kenny He — fotografía de eventos"
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
      class="hero__img"
    />
    <div class="hero__overlay"></div>
    <div class="wrap hero__content">
      <p class="eyebrow hero__eyebrow">{t('site.tagline')}</p>
      <h1 class="hero__title">Kenny He</h1>
      <p class="hero__scroll">{t('home.scroll')}</p>
    </div>
  </section>

  <section class="intro wrap fade-in">
    <p class="intro__text">{t('home.intro')}</p>
  </section>

  <section class="selected wrap">
    <p class="eyebrow fade-in">{t('home.selectedWork')}</p>
    <div class="selected__grid">
      {
        events.map((event) => (
          <EventCard
            lang={lang}
            slug={event.id}
            title={event.data.title}
            location={event.data.location}
            date={event.data.date}
          />
        ))
      }
    </div>
  </section>

  <ServicesStrip lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.1) 45%, rgba(0, 0, 0, 0.55) 100%);
  }

  .hero__content {
    position: relative;
    color: #fff;
    padding-bottom: 4rem;
    width: 100%;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    margin-top: 0.5rem;
  }

  .hero__scroll {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .intro {
    padding-block: 5rem 3rem;
  }

  .intro__text {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    max-width: 30ch;
    line-height: 1.35;
  }

  .selected {
    padding-block: 1.5rem 5rem;
  }

  .selected__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 720px) {
    .selected__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
