---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import ServicesStrip from '../components/ServicesStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { useTranslations } from '../i18n/ui';
import { findImage, getCover, getEventImages } from '../lib/images';

const lang = 'en' as const;
const t = useTranslations(lang);

const events = (await getCollection('eventsEn')).sort((a, b) => a.data.order - b.data.order);
const weddingImages = getEventImages('wedding-bali');
const heroCover = getCover(weddingImages);
// Portrait phones get a vertical photo instead of a tight crop of the landscape cover.
const heroPortrait = findImage(weddingImages, 'KEN07383', heroCover);
const heroPortraitSrcset = (
  await Promise.all(
    [480, 800, 1200].map(async (width) => {
      const img = await getImage({ src: heroPortrait.file, width, format: 'webp' });
      return `${img.src} ${width}w`;
    }),
  )
).join(', ');
---

<BaseLayout
  lang={lang}
  path="/"
  title={t('site.title')}
  description={t('site.description')}
  ogImage={heroCover.file}
  transparentHeader
>
  <section class="hero">
    <picture>
      <source media="(max-aspect-ratio: 3/4)" srcset={heroPortraitSrcset} sizes="100vw" type="image/webp" />
      <Image
        src={heroCover.file}
        alt="Kenny He, event photography"
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        class="hero__img"
      />
    </picture>
    <div class="hero__overlay"></div>
    <div class="wrap hero__content">
      <p class="eyebrow hero__eyebrow">{t('site.tagline')}</p>
      <h1 class="hero__title">Kenny He</h1>
      <div class="hero__scroll">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span class="visually-hidden">{t('home.scroll')}</span>
      </div>
    </div>
  </section>

  <section class="intro wrap fade-in">
    <p class="intro__text">{t('home.intro')}</p>
  </section>

  <section class="selected wrap">
    <p class="eyebrow fade-in">{t('home.selectedWork')}</p>
    <div class="selected__grid">
      {
        events.map((event) => (
          <EventCard
            lang={lang}
            slug={event.id}
            title={event.data.title}
            location={event.data.location}
            date={event.data.date}
          />
        ))
      }
    </div>
  </section>

  <ServicesStrip lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.1) 45%, rgba(0, 0, 0, 0.55) 100%);
  }

  .hero__content {
    position: relative;
    color: #fff;
    padding-bottom: 4rem;
    width: 100%;
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    margin-top: 0.5rem;
  }

  .hero__scroll {
    margin-top: 2.5rem;
  }

  .hero__scroll-line {
    display: block;
    position: relative;
    width: 1px;
    height: 48px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.25);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-100%);
    animation: scroll-pulse 2.4s var(--ease) infinite;
  }

  @keyframes scroll-pulse {
    0% {
      transform: translateY(-100%);
    }
    70%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after {
      animation: none;
      transform: none;
      background: rgba(255, 255, 255, 0.5);
    }
  }

  .intro {
    padding-block: 5rem 3rem;
  }

  .intro__text {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    max-width: 30ch;
    line-height: 1.35;
  }

  .selected {
    padding-block: 1.5rem 5rem;
  }

  .selected__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 720px) {
    .selected__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
