---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';
import { href } from '../lib/paths';
import portrait from '../assets/about/portrait1.jpg';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/about" title={`${t('about.heading')} — ${t('site.title')}`}>
  <section class="wrap about">
    <div class="about__intro fade-in">
      <p class="eyebrow">{t('about.kicker')}</p>
      <h1>{t('about.heading')}</h1>
    </div>

    <div class="about__grid">
      <div class="about__portrait fade-in">
        <Image
          src={portrait}
          alt="Kenny He"
          widths={[400, 700, 1000]}
          sizes="(min-width: 860px) 36vw, 90vw"
          loading="lazy"
          format="webp"
        />
      </div>
      <div class="about__bio fade-in">
        <p>{t('about.bio.p1')}</p>
        <p>{t('about.bio.p2')}</p>
        <p class="about__services-note">
          {t('about.services.prompt')}{' '}
          <a href={href('/services', lang)}>{t('about.services.cta')}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: 8.5rem 5rem;
  }

  .about__intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: 0.4rem;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 3rem;
    align-items: start;
  }

  .about__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-size: 1.08rem;
    max-width: 58ch;
  }

  .about__bio p:first-child {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
  }

  .about__services-note {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .about__services-note a {
    color: var(--color-text);
    border-bottom: 1px solid var(--color-accent);
  }

  @media (min-width: 720px) {
    .about__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
    }
  }
</style>
