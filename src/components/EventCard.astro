---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { href } from '../lib/paths';
import { getCover, getEventImages } from '../lib/images';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  location: string;
  date: string;
}

const { lang, slug, title, location, date } = Astro.props;
const t = useTranslations(lang);
const cover = getCover(getEventImages(slug));
---

<a class="event-card fade-in" href={href(`/work/${slug}`, lang)}>
  <div class="event-card__media">
    <Image
      src={cover.file}
      alt={title}
      widths={[480, 800, 1200, 1800]}
      sizes="(min-width: 900px) 50vw, 100vw"
      loading="lazy"
      format="webp"
    />
  </div>
  <div class="event-card__body">
    <p class="eyebrow">{location} · {date}</p>
    <h3 class="event-card__title">{title}</h3>
    <span class="event-card__link">{t('work.viewStory')} &rarr;</span>
  </div>
</a>

<style>
  .event-card {
    display: block;
    color: var(--color-text);
  }

  .event-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg-raised);
  }

  .event-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .event-card:hover .event-card__media :global(img) {
    transform: scale(1.035);
  }

  .event-card__body {
    padding-top: 1.1rem;
  }

  .event-card__title {
    font-size: 1.5rem;
    margin-top: 0.35rem;
  }

  .event-card__link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .event-card:hover .event-card__link {
    color: var(--color-accent);
  }
</style>
